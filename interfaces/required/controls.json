{
  "id": "controls",
  "type": "ae/controls",
  "version": "1.0.0",
  "notes": "What guided-tour takes from the controls component: the ControlsLike object in tour-view.ts. The real panel and button of controls fit.",
  "operations": {
    "panel": {
      "arguments": [
        "options:{title?:string,active?:boolean,className?:string,attrs?:map<string,string>}",
        "...children:Child[]"
      ],
      "returns": "HTMLElement"
    },
    "button": {
      "arguments": [
        "options:{label:string,onClick:()=>void,variant?:'primary'|'ghost'|'link',attrs?:map<string,string>}"
      ],
      "returns": "HTMLElement"
    }
  }
}
